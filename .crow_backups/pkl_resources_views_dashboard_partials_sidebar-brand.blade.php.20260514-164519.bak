<script>
    (() => {
        const THEME_KEY = 'kips_theme_preference';
        let chosen = 'dark';
        const syncToggleButtons = () => {
            const buttons = document.querySelectorAll('.theme-toggle-btn');
            buttons.forEach((btn) => {
                btn.innerHTML = chosen === 'light' ? '&#127769;' : '&#9728;';
                btn.setAttribute('aria-label', chosen === 'light' ? 'Switch to dark mode' : 'Switch to light mode');
                btn.setAttribute('title', chosen === 'light' ? 'Dark mode' : 'Light mode');
            });
        };
        const applyTheme = (value, persist = true) => {
            chosen = value === 'light' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', chosen);
            if (persist) {
                try {
                    localStorage.setItem(THEME_KEY, chosen);
                } catch (error) {
                    // Ignore localStorage access issues.
                }
            }
            syncToggleButtons();
        };

        try {
            const stored = localStorage.getItem(THEME_KEY);
            if (stored === 'light' || stored === 'dark') chosen = stored;
        } catch (error) {
            // Ignore localStorage access issues.
        }
        applyTheme(chosen, false);
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', syncToggleButtons, { once: true });
        } else {
            syncToggleButtons();
        }

        document.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const toggle = target.closest('.theme-toggle-btn');
            if (!toggle) return;
            applyTheme(chosen === 'light' ? 'dark' : 'light');
        });
    })();
</script>

